module(
    name = "swift-bylaws",
    version = "0.7.0",
    compatibility_level = 1,
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_lib", version = "3.7.2")

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

_BASE = "https://github.com/theblixguy/swift-bylaws/releases/download/v0.7.0"

http_archive(
    name = "bylaws_macos",
    sha256 = "12276899d4b1c873f1eae3ec48f51cb31d92f70d2e06377ce26eda62d8ec1092",
    urls = [_BASE + "/bylaws-macos.tar.gz"],
)

http_archive(
    name = "bylaws_linux",
    sha256 = "07b7ee2253b0631f6b0512f92c8ec347b9e05a54ae3c1e9aebe26c90c724db2b",
    urls = [_BASE + "/bylaws-linux.tar.gz"],
)
